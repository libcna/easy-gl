#pragma once

#include <string_view>

/// @file Version.hpp
/// @brief The easy-gl release a translation unit is compiled against.
///
/// Generated by cmake/EasyGlVersion.cmake from cmake/templates/Version.hpp.in. The version
/// itself is decided in one place only -- project(easy-gl VERSION ...) and
/// EASYGL_VERSION_PRERELEASE in the root CMakeLists.txt (see docs/releasing.md). Never edit the
/// generated copy in the build tree.
///
/// This is easy-gl's own version. The meta-gl release underneath has its own, in
/// <metagl/Version.hpp>, and the OpenGL / OpenGL ES version of a live context is reported at
/// runtime by easygl::ContextInfo.
///
/// The object-like macros exist because a constexpr value cannot be tested by the preprocessor;
/// use them for compile-time feature gating (`#if EASYGL_VERSION_MINOR >= 2`) and the constants
/// below for everything else.

/// Major component of the easy-gl release, as a preprocessor-testable integer literal.
#define EASYGL_VERSION_MAJOR @PROJECT_VERSION_MAJOR@

/// Minor component of the easy-gl release, as a preprocessor-testable integer literal.
#define EASYGL_VERSION_MINOR @PROJECT_VERSION_MINOR@

/// Patch component of the easy-gl release, as a preprocessor-testable integer literal.
#define EASYGL_VERSION_PATCH @PROJECT_VERSION_PATCH@

/// Pre-release identifier without its leading '-'; an empty string on a final release.
#define EASYGL_VERSION_PRERELEASE "@EASYGL_VERSION_PRERELEASE@"

/// The complete release string, e.g. "0.1.0" or "0.2.0-beta.1"; no leading 'v'.
#define EASYGL_VERSION_STRING "@EASYGL_VERSION_STRING@"

namespace easygl
{
    inline constexpr int version_major = EASYGL_VERSION_MAJOR;
    inline constexpr int version_minor = EASYGL_VERSION_MINOR;
    inline constexpr int version_patch = EASYGL_VERSION_PATCH;

    /// Pre-release identifier ("beta.1" for 0.2.0-beta.1); empty on a final release.
    inline constexpr std::string_view version_prerelease = EASYGL_VERSION_PRERELEASE;

    /// The complete release string in Semantic Versioning spelling, e.g. "0.1.0".
    inline constexpr std::string_view version_string = EASYGL_VERSION_STRING;

    /// True for an alpha, beta or release-candidate build, false on a final release.
    inline constexpr bool version_is_prerelease = !version_prerelease.empty();
}
